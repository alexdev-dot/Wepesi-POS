# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (for server-side operations)
# Get this from Supabase Dashboard > Settings > API > service_role (secret)
# NEVER commit this to version control or expose it to clients
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Super Admin Configuration
# These are used by the seed script to create the initial super admin user
SUPER_ADMIN_EMAIL=your_admin_email_here
SUPER_ADMIN_PASSWORD=your_admin_password_here

# Security Configuration
# In production, use a strong random secret for JWT signing
JWT_SECRET=your_jwt_secret_here

# Google OAuth Configuration
# Get these from Google Cloud Console after setting up OAuth credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# MFA Configuration (optional, for future implementation)
MFA_ISSUER=your_mfa_issuer
